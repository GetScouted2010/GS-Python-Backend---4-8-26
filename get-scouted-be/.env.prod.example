# Copy this to .env.prod for production Docker deployment on EC2
# Never commit this file — it contains real secrets

SECRET_KEY=replace-with-a-very-long-random-string
ALLOWED_HOSTS=api.yourdomain.com

# 'db' = the postgres service name in docker-compose.prod.yml
DATABASE_URL=postgresql://getscouted:YOUR_STRONG_DB_PASSWORD@db:5432/getscouted
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD

# Dataset is baked into the image at /app/dataset (see Dockerfile / .dockerignore)
DATASET_DIR=/app/dataset

# Set to True once HTTPS (Part 7 of docs/deploy-docker-ec2.md) is live —
# enables SSL redirect, secure cookies, and HSTS.
HTTPS_ENABLED=False

# LLM provider abstraction. Leave ANTHROPIC_API_KEY blank to force every NL
# search onto the deterministic keyword fallback (never errors).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_REPORT_MODEL=
