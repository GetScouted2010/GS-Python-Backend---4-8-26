SECRET_KEY=
DEBUG=True
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/getscouted
# Leave blank to use the default repo-relative API-Updated-/dataset path
DATASET_DIR=

# LLM provider abstraction (Phase 9). LLM_PROVIDER selects the parser implementation.
LLM_PROVIDER=anthropic
# Get a key from https://console.anthropic.com/settings/keys . Leave blank to force
# every NL search onto the deterministic keyword fallback (never errors).
ANTHROPIC_API_KEY=
# Env-overridable model id (see settings comment). Blank uses the verified default.
ANTHROPIC_MODEL=
