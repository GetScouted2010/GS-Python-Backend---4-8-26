*.pyc
__pycache__/
.env
db.sqlite3
.venv/
venv/

# Trained ML artifacts (regenerable via `manage.py train_tfm_model`) --
# keep the directory tracked via ml_artifacts/.gitkeep, but not the
# generated binaries/metrics themselves.
scoring/ml_artifacts/*.joblib
scoring/ml_artifacts/*.metrics.json

# Per-group parity mismatch-detail reports (write_mismatch_report in
# scoring/tests/_parity_helpers.py) -- regenerated on every failing
# parity test run, never committed.
scoring/tests/_parity_reports/

# Generated OpenAPI schema (make schema / manage.py spectacular) -- regenerate
# on demand, never a source-of-truth artifact.
schema.yaml
