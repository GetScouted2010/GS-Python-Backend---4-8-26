# Copy this to .env.docker for local Docker development
# The hostname 'db' is a Docker service name — do NOT use localhost

SECRET_KEY=local-docker-dev-secret-key-change-me

# 'db' = the postgres service name in docker-compose.yml
DATABASE_URL=postgresql://getscouted:getscouted@db:5432/getscouted

# Dataset is baked into the image at /app/dataset (see Dockerfile / .dockerignore)
DATASET_DIR=/app/dataset

# LLM provider abstraction. Leave ANTHROPIC_API_KEY blank to force every NL
# search onto the deterministic keyword fallback (never errors).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_REPORT_MODEL=
